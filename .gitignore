# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Environment files (keep examples versioned)
.env
.env.*
!.env.example
!**/.env.example

# Raw and generated data should not be committed
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/models/*
!outputs/models/.gitkeep
*.parquet
*.duckdb
*.duckdb.wal

# Model binaries are generated by the training job
artifacts/models/*
!artifacts/models/.gitkeep

# Frontend
node_modules/
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
apps/web/.env*.local

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# OS and editors
.DS_Store
Thumbs.db
.idea/

# LaTeX auxiliary files
*.aux
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.xdv
